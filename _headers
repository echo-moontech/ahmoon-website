# ============================================
# 全局默认规则 —— 所有路径都会命中这一条
# 安全头 + HTML 的默认缓存策略都放在这里，
# 后续更具体的路径规则只覆盖 Cache-Control，安全头会自动继承
# ============================================
/*
  # 安全响应头
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff

  # HTML 默认缓存 1 小时：保证内容更新能快速生效
  # 注意：不要在 *.html / /products/* 里重复声明这一条，
  # 否则 Cloudflare 会把两个值拼接输出成两遍
  Cache-Control: public, max-age=3600, must-revalidate

# ============================================
# 长期不变的媒体资源 —— 30 天 immutable
# 图片/视频基本不改，用 immutable 避免重复校验请求
# ============================================
/images/*
  Cache-Control: public, max-age=2592000, immutable
/videos/*
  Cache-Control: public, max-age=2592000, immutable

# ============================================
# 文档下载（TDS / COA / SDS 等 PDF）
# 会随产品更新而替换，用 7 天 + 强制校验
# ============================================
/downloads/*
  Cache-Control: public, max-age=604800, must-revalidate

# ============================================
# CSS / JS —— 7 天
# 不用 immutable，改版后用户最多 7 天就能拿到新版
# ============================================
*.css
  Cache-Control: public, max-age=604800
*.js
  Cache-Control: public, max-age=604800
*.svg
  Cache-Control: public, max-age=604800
*.ico
  Cache-Control: public, max-age=2592000

# ============================================
# SEO 文件 —— 1 小时，保证 Google 及时拿到最新的
# ============================================
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
